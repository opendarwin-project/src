+#!/usr/bin/env python3
+import sys, os, re, subprocess
+
+def doconf(argv):
+    prog = os.path.basename(argv[0])
+    objdir = "../BUILD"
+    sourcedir = "."
+    master_conf_dir = "."
+    def_seed = ""
+    def_avp = ""
+    doconfig = False
+    beverbose = False
+    machine = ""
+    profile = False
+    soc_config = ""
+    platform = ""
+    srcroot = os.environ.get("SRCROOT", ".")
+    objroot = os.environ.get("OBJROOT", objdir)
+    config_dir = os.path.join(objroot, "SETUP/config")
+
+    i = 1
+    sys_configs = []
+    while i < len(argv):
+        arg = argv[i]
+        if arg in ("-c", "-config"):
+            doconfig = True
+            i += 1
+        elif arg == "-cpu":
+            machine = argv[i+1]
+            i += 2
+        elif arg == "-soc":
+            soc_config = argv[i+1]
+            if soc_config.startswith("vm"):
+                def_avp = "-DSOC_IS_VIRTUALIZED"
+            else:
+                def_avp = "-USOC_IS_VIRTUALIZED"
+            i += 2
+        elif arg == "-platform":
+            platform = argv[i+1]
+            i += 2
+        elif arg == "-d":
+            objdir = argv[i+1]
+            i += 2
+        elif arg == "-m":
+            master_conf_dir = argv[i+1]
+            i += 2
+        elif arg == "-s":
+            sourcedir = argv[i+1]
+            i += 2
+        elif arg == "-verbose":
+            beverbose = True
+            i += 1
+        elif arg in ("-p", "-profile"):
+            profile = True
+            i += 1
+        elif arg.startswith("-"):
+            print(f"{prog}: {arg}: unknown switch", file=sys.stderr)
+            sys.exit(1)
+        else:
+            sys_configs.append(arg)
+            i += 1
+
+    if not sys_configs:
+        sys_configs = ["GENERIC"]
+
+    if not machine:
+        print(f"{prog}: MACHINE not set", file=sys.stderr)
+        sys.exit(1)
+
+    cpu = machine.lower()
+    ID = machine.upper()
+    master = os.path.join(master_conf_dir, "MASTER")
+    master_cpu = ""
+    candidates = [
+        f"{master}.{cpu}.{soc_config}.{platform}",
+        f"{master}.{cpu}.{soc_config}",
+        f"{master}.{cpu}.{platform}",
+        f"{master}.{cpu}",
+    ]
+    for c in candidates:
+        if os.path.isfile(c):
+            master_cpu = c
+            break
+
+    for sys_name in sys_configs:
+        sysid = f"{sys_name}_{ID}"
+        sysconf = os.path.join(objdir, f"config.{sysid}")
+        if beverbose:
+            print(f"[ generating {sysid} from {master_conf_dir}/MASTER{{,.{cpu}}}{{,.local}} ]")
+
+        with open(master) as f:
+            master_content = f.read()
+        master_cpu_content = ""
+        if master_cpu and os.path.isfile(master_cpu):
+            with open(master_cpu) as f:
+                master_cpu_content = f.read()
+
+        unifdef_cmd = [
+            "unifdef", "-t",
+            f"-DPLATFORM_{platform}",
+            f"-DCPU_{cpu}",
+            f"-DSOC_CONFIG_{soc_config}",
+            f"-DSYS_{sys_name}"
+        ]
+        if def_avp:
+            unifdef_cmd.append(def_avp)
+        if def_seed:
+            unifdef_cmd.append(def_seed)
+
+        p = subprocess.run(
+            unifdef_cmd,
+            input=f"{master_content}\n{master_cpu_content}",
+            stdout=subprocess.PIPE,
+            text=True
+        )
+        lines = p.stdout.splitlines()
+
+        mappings = {}
+        content_lines = []
+        for line in lines:
+            m = re.match(r'^\s*#?\s*([A-Za-z0-9_]+)\s*=\s*\[(.*?)\]', line)
+            if m:
+                mappings[m.group(1)] = m.group(2).split()
+            else:
+                content_lines.append(line)
+
+        active_tags = set()
+        stack = [sys_name]
+        while stack:
+            item = stack.pop()
+            if item in mappings:
+                for sub in mappings[item]:
+                    stack.append(sub)
+            else:
+                active_tags.add(item)
+
+        result_lines = []
+        for line in content_lines:
+            sline = line.strip()
+            if not sline or sline.startswith('#'):
+                continue
+            m = re.search(r'#\s*<([^>]+)>\s*$', line)
+            if m:
+                selector = m.group(1)
+                code_part = line[:m.start()].rstrip()
+                sel_items = [t.strip() for t in selector.split(',')]
+                ok = False
+                for t in sel_items:
+                    if t.startswith('!'):
+                        if t[1:] not in active_tags:
+                            ok = True
+                    else:
+                        if t in active_tags:
+                            ok = True
+                if ok:
+                    result_lines.append(code_part)
+            else:
+                result_lines.append(line)
+
+        result_lines.append('builddir\t"."')
+        result_lines.append(f'objectdir\t"{objdir}"')
+        result_lines.append(f'sourcedir\t"{srcroot}"')
+
+        os.makedirs(objdir, exist_ok=True)
+        with open(f"{sysconf}.new", "w") as f:
+            f.write("\n".join(result_lines) + "\n")
+
+        if os.path.isfile(sysconf):
+            if os.path.isfile(f"{sysconf}.old"):
+                os.unlink(f"{sysconf}.old")
+            os.rename(sysconf, f"{sysconf}.old")
+        os.rename(f"{sysconf}.new", sysconf)
+
+        if doconfig:
+            if beverbose:
+                print(f"[ configuring {sysid} ]")
+            config_bin = os.path.join(config_dir, "config")
+            cfg_cmd = [config_bin, "-c", sourcedir]
+            if profile:
+                cfg_cmd.append("-p")
+            cfg_cmd.append(sysconf)
+            subprocess.run(cfg_cmd, check=True)
+
+if __name__ == "__main__":
+    doconf(sys.argv)
