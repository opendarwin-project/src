#!/usr/bin/env python3
"""Minimal plutil(1) shim for building XNU on Linux.

Supports the subset of plutil flags XNU's build system uses:
  plutil -lint [-s] [--] <file...>          validate plists, exit 0 if all ok
  plutil -convert binary1|xml1 [-s] [--] <file...>  rewrite plists in place
  plutil -p [--] <file...>                  print plists as JSON (informal)
Everything else exits 2 with a usage message, like real plutil.
"""

import json
import os
import plistlib
import sys
import tempfile


def usage(fd=sys.stderr):
    print("Usage:", file=fd)
    print("  plutil -help", file=fd)
    print("  plutil -lint [-s] -- file ...", file=fd)
    print("  plutil -convert xml1|binary1 [-s] -- file ...", file=fd)
    print("  plutil -p [--] file", file=fd)
    sys.exit(2)


def parse_file(path):
    with open(path, "rb") as f:
        return plistlib.load(f)


def lint(path, silent):
    try:
        parse_file(path)
    except Exception as e:
        if not silent:
            print(f"{path}: {e}", file=sys.stderr)
        return 1
    if not silent:
        print(f"{path}: OK")
    return 0


def convert(path, fmt, silent):
    try:
        data = parse_file(path)
        payload = plistlib.dumps(data, fmt=fmt, sort_keys=False)
        with tempfile.NamedTemporaryFile(dir=os.path.dirname(os.path.abspath(path)) or ".", delete=False) as tmp:
            tmp.write(payload)
            tmpname = tmp.name
        os.chmod(tmpname, os.stat(path).st_mode & 0o7777)
        os.replace(tmpname, path)
    except Exception as e:
        if not silent:
            print(f"{path}: {e}", file=sys.stderr)
        return 1
    if not silent:
        print(f"{path}: OK")
    return 0


def main(argv):
    if not argv:
        usage()
    cmd = argv[0]

    if cmd == "-help":
        usage(sys.stdout)

    # Strip -s (silent) flags and -- separators from the argument list.
    rest = []
    for a in argv[1:]:
        if a == "-s":
            continue
        if a == "--":
            continue
        rest.append(a)

    if cmd == "-lint":
        if not rest:
            usage()
        return max(lint(p, False) for p in rest)

    if cmd == "-convert":
        if not rest:
            usage()
        fmt_arg = rest[0]
        files = rest[1:]
        if not files:
            usage()
        if fmt_arg == "binary1":
            fmt = plistlib.FMT_BINARY
        elif fmt_arg == "xml1":
            fmt = plistlib.FMT_XML
        else:
            print(f"plutil: unsupported format '{fmt_arg}'", file=sys.stderr)
            return 2
        return max(convert(p, fmt, False) for p in files)

    if cmd == "-p":
        if not rest:
            usage()
        rc = 0
        for p in rest:
            try:
                print(json.dumps(parse_file(p), indent=2, default=str))
            except Exception as e:
                print(f"{p}: {e}", file=sys.stderr)
                rc = 1
        return rc

    usage()
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))