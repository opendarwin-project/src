--- a/osfmk/kern/kalloc.h
+++ b/osfmk/kern/kalloc.h
@@ -69,6 +69,24 @@
 #include <kern/counter.h>
 #endif /* XNU_KERNEL_PRIVATE */
 
+/*
+ * Apple Clang implements kalloc-type builtins that stock LLVM does not.
+ * Treat missing builtins as data-only / always-compatible so the real
+ * kalloc_type call sites still compile.
+ */
+#ifndef __has_builtin
+#define __has_builtin(x) 0
+#endif
+#if !__has_builtin(__builtin_xnu_type_summary)
+#define __builtin_xnu_type_summary(type) 0u
+#endif
+#if !__has_builtin(__builtin_xnu_type_signature)
+#define __builtin_xnu_type_signature(type) ""
+#endif
+#if !__has_builtin(__builtin_xnu_types_compatible)
+#define __builtin_xnu_types_compatible(a, b) 1
+#endif
+
 __BEGIN_DECLS __ASSUME_PTR_ABI_SINGLE_BEGIN
 
