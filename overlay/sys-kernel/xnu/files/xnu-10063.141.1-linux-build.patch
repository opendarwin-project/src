-			break;
-		}
-		next = eol + 1;
-
-		/* Skip empty lines.
-		 */
-		if (eol == scan) {
-			continue;
-		}
-
-		*eol = '\0';
-
-		/* Skip comment lines.
-		 */
-		if (scan[0] == '#') {
-			continue;
-		}
-
-		/* Scan past any non-symbol characters at the beginning of the line. */
