+#ifndef _SETUP_COMPAT_H_
+#define _SETUP_COMPAT_H_
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include <errno.h>
+#include <unistd.h>
+
+#ifndef getprogname
+static inline const char *getprogname(void) {
+    extern const char *__progname;
+    return __progname ? __progname : "xnu-setup";
+}
+#endif
+
+#define COPYFILE_DATA (1<<1)
+
+static inline int fcopyfile(int srcfd, int dstfd, void *state, int flags) {
+    char buf[65536];
+    ssize_t n;
+    while ((n = read(srcfd, buf, sizeof(buf))) > 0) {
+        char *p = buf;
+        while (n > 0) {
+            ssize_t w = write(dstfd, p, n);
+            if (w < 0) {
+                if (errno == EINTR) continue;
+                return -1;
+            }
+            p += w;
+            n -= w;
+        }
+    }
+    return (n < 0) ? -1 : 0;
+}
+
+#endif
+
+#include <stdlib.h>
+static inline void *setmode(const char *mode_str) {
+    char *endptr;
+    long val = strtol(mode_str, &endptr, 8);
+    if (*endptr != '\0') return NULL;
+    long *m = malloc(sizeof(long));
+    if (m) *m = val;
+    return m;
+}
+
+static inline mode_t getmode(const void *bbox, mode_t omode) {
+    if (!bbox) return omode;
+    return (mode_t)(*(const long *)bbox);
+}
