-		unsigned int name_len = 0;
-		char *       indirect = NULL;
-		char *       indirect_term = NULL;
-		unsigned int indirect_len = 0;
-		char *       option = NULL;
-		char *       option_term = NULL;
-		unsigned int option_len = 0;
