#!/usr/bin/env bash
# OpenDarwin Nix CLI wrapper
#
# Builds (if necessary) and dispatches to the Rust implementation in
# rix/rix-cli. The dispatch name mirrors standard Nix tooling so that
# `nix-build`, `nix-instantiate`, `nix-shell`, etc. all work.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="$repo_root/target/release/rix-cli"

if [ ! -x "$binary" ]; then
  (cd "$repo_root" && cargo build --release >/dev/null 2>&1)
fi

exec env RIX_PROG_NAME="$(basename "$0")" "$binary" "$@"