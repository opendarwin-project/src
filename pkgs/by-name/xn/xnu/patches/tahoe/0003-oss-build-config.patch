index e37762bc..1971214a 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,10 +29,11 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE QEMU SUPERBIRD IPAD41
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
+OSSHW_SOCS = qemu superbird ipad41
 
 
 endif
@@ -94,6 +95,10 @@ MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+
 
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
 
+MACHINE_FLAGS_ARM64_QEMU = -DARM64_BOARD_CONFIG_QEMU -mcpu=cortex-a53
+MACHINE_FLAGS_ARM64_SUPERBIRD = -DARM64_BOARD_CONFIG_SUPERBIRD -mcpu=cortex-a53
+MACHINE_FLAGS_ARM64_IPAD41 = -DARM64_BOARD_CONFIG_IPAD41 -mcpu=cyclone
+
 
 #
 # Deployment target flag
@@ -354,6 +359,10 @@ ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG ?=
 
 ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 
+ifneq ($(filter qemu superbird ipad41,$(CURRENT_MACHINE_CONFIG_LC)),)
+export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64
+endif
+
 ifneq ($(EMBEDDED_DEVICE_MAP),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell $(EMBEDDED_DEVICE_MAP) -db $(EDM_DBPATH) -list -query SELECT DISTINCT KernelMachOArchitecture FROM Targets WHERE KernelPlatform IS \"$(CURRENT_MACHINE_CONFIG_LC)\" LIMIT 1 || echo UNKNOWN )
 ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
@@ -1151,7 +1160,8 @@ LD_KERNEL_LIBS	   = -lcc_kext
 LD_KERNEL_ARCHIVES = $(LDFLAGS_KERNEL_SDK) -lfirehose_kernel
 
 # Link binary support library
-ifneq ($(CURRENT_MACHINE_CONFIG),NONE)
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG),NONE $(shell echo $(OSSHW_SOCS) | tr a-z A-Z)),)
+else
         LDFLAGS_KERNEL_ONLY += -rdynamic -Wl,-force_load,$(KDKROOT)/System/Library/KernelSupport/lib$(CURRENT_MACHINE_CONFIG).os.$(CURRENT_KERNEL_CONFIG).a
 endif
 
@@ -1179,6 +1189,10 @@ ifneq ($(filter $(CURRENT_MACHINE_CONFIG_LC),$(EXCLAVES_ENABLED_SOCS_$(PLATFORM)
   EXCLAVES_ENABLED := 1
 endif
 
+ifneq ($(filter $(CURRENT_MACHINE_CONFIG_LC),$(OSSHW_SOCS)),)
+  DOCONF_OSSHW := -osshw
+endif
+
 ifeq ($(SPTM_ENABLED),1)
   LD_KERNEL_ARCHIVES += -lTrustedExecutionMonitor_Kernel
   LD_KERNEL_ARCHIVES += -lsptm_xnu
