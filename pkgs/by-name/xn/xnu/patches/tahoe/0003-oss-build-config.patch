From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Theo Paris <theo@theoparis.com>
Date: Tue, 15 Sep 2026 20:21:39 -0700
Subject: [PATCH 03/11] build: add OSS hardware board config and no-KDK build
 fixes

  * doconf gains -osshw / MASTER_CONFIG_OSS_HARDWARE, threaded through
    every conf/Makefile, so OSS-hardware boards (qemu, superbird,
    ipad41) select the non-Apple-silicon config paths.
  * MakeInc.def registers the QEMU/SUPERBIRD/IPAD41 machine configs and
    flags, OSSHW_SOCS, the arm64 ARCH_STRING fallback, and the
    KernelSupport archive/link handling for those boards.
  * make_symbol_aliasing.sh resolves availability.pl via FAKEROOT_DIR
    instead of DRIVERKITROOT, and Libsyscall.xcconfig no longer includes
    a DEVELOPER_DIR-relative BSD.xcconfig, so a bare SDK layout builds
    without a KDK.
---
 SETUP/config/doconf             |  5 ++++-
 bsd/conf/Makefile               |  2 +-
 bsd/sys/make_symbol_aliasing.sh |  2 +-
 iokit/conf/Makefile             |  2 +-
 libkern/conf/Makefile           |  2 +-
 libsa/conf/Makefile             |  2 +-
 libsyscall/Libsyscall.xcconfig  |  2 +-
 makedefs/MakeInc.def            | 18 ++++++++++++++++--
 osfmk/conf/Makefile             |  2 +-
 pexpert/conf/Makefile           |  2 +-
 san/conf/Makefile               |  2 +-
 security/conf/Makefile          |  2 +-
 12 files changed, 30 insertions(+), 13 deletions(-)

diff --git a/SETUP/config/doconf b/SETUP/config/doconf
index 296699b3..36e88ba5 100755
--- a/SETUP/config/doconf
+++ b/SETUP/config/doconf
@@ -163,6 +163,9 @@ while ($#argv >= 1)
 	case "-tag":
 	    set DEF_TAG="-DMASTER_CONFIG_ENABLE_KERNEL_TAG"
 	    breaksw
+	case "-osshw":
+	    set DEF_OSSHW="-DMASTER_CONFIG_OSS_HARDWARE"
+	    breaksw
 	default:
 	    echo "${prog}: ${argv[1]}: unknown switch"
 	    exit 1
@@ -209,7 +212,7 @@ foreach SYS ($argv)
     cat $MASTER $MASTER_CPU - \
         $MASTER $MASTER_CPU \
     | \
-    unifdef -t -DPLATFORM_${PLATFORM} -DCPU_$cpu -DSOC_CONFIG_${SOC_CONFIG} -DSYS_${SYS} $DEF_AVP $DEF_SEED $DEF_EXCLAVES $DEF_SPTM $DEF_BUILD $DEF_TAG - \
+    unifdef -t -DPLATFORM_${PLATFORM} -DCPU_$cpu -DSOC_CONFIG_${SOC_CONFIG} -DSYS_${SYS} $DEF_AVP $DEF_SEED $DEF_EXCLAVES $DEF_SPTM $DEF_BUILD $DEF_TAG $DEF_OSSHW - \
     | \
     sed -n \
 	-e "/^+/{" \
