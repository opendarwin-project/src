+	$(_v)$(SRCROOT)/SETUP/config/doconf -c -cpu $(DOCONF_ARCH_CONFIG_LC) -soc $(CURRENT_MACHINE_CONFIG_LC) -platform $(PLATFORM_FOR_CONFIG) -d $(TARGET)/$(CURRENT_KERNEL_CONFIG) -s $(SOURCE) -m $(MASTERCONFDIR) $(DOCONF_SEED) $(DOCONF_EXCLAVES) $(DOCONF_SPTM) $(DOCONF_KERNEL_TAG) $(DOCONF_OSSHW) $(CURRENT_KERNEL_CONFIG)
 
