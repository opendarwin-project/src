From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Theo Paris <theo@theoparis.com>
Date: Sat, 12 Sep 2026 23:46:25 -0700
Subject: [PATCH 08/11] dsymutil: don't use process subsitution

Signed-off-by: Theo Paris <theo@theoparis.com>
(cherry picked from commit c4d6a8da4b9d42258859fc15edf6f3166559676f)
---
 makedefs/MakeInc.kernel | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/makedefs/MakeInc.kernel b/makedefs/MakeInc.kernel
index d34009a6..aabb9627 100644
--- a/makedefs/MakeInc.kernel
+++ b/makedefs/MakeInc.kernel
@@ -173,7 +173,7 @@ endif
 $(TARGET)/$(KERNEL_FILE_NAME).dSYM: $(TARGET)/$(KERNEL_FILE_NAME).unstripped.noctf
 ifeq ($(BUILD_DSYM),1)
 	@$(LOG_DSYMUTIL) "$(@F)"
-	$(_v)$(BASH) -c "$(DSYMUTIL) $(DSYMUTIL_FLAGS) $< -o $@ $(_vstdout) 2> >(grep -v '^warning:.*could not find object file symbol for symbol' 1>&2)"
+	$(_v)$(DSYMUTIL) $(DSYMUTIL_FLAGS) $< -o $@ $(_vstdout) $(_vstderr)
 	$(_v)$(MV) $@/$(DSYMDWARFDIR)/$(KERNEL_FILE_NAME).unstripped.noctf $@/$(DSYMDWARFDIR)/$(KERNEL_FILE_NAME)
 else
 	$(_v)$(MKDIR) $@
