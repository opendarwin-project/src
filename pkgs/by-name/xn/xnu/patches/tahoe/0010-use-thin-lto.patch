From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Theo Paris <theo@theoparis.com>
Date: Sun, 13 Sep 2026 00:20:36 -0700
Subject: [PATCH 10/11] Use thin lto

Signed-off-by: Theo Paris <theo@theoparis.com>
(cherry picked from commit 5cc8132209c1099126fb7f97c79cb8ef3f2c65c9)
---
 makedefs/MakeInc.def | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 638d7f60..a0ae7ab1 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1325,8 +1325,8 @@ USE_LTO = $(LTO_ENABLED_$(CURRENT_KERNEL_CONFIG))
 endif
 
 ifeq ($(USE_LTO),1)
-CFLAGS_GEN	+= -flto -DBUILT_LTO=1
-CXXFLAGS_GEN	+= -flto -DBUILT_LTO=1
+CFLAGS_GEN	+= -flto=thin -DBUILT_LTO=1
+CXXFLAGS_GEN	+= -flto=thin -DBUILT_LTO=1
 LDFLAGS_KERNEL_LTO	= -Wl,-mllvm,-inline-threshold=100
 LDFLAGS_KERNEL_GEN	+= $(LDFLAGS_KERNEL_LTO) -Wl,-object_path_lto,$(TARGET)/lto.o
 LDFLAGS_NOSTRIP_FLAG = -rdynamic
