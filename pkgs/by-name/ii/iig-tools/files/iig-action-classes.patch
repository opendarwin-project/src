+/* Apple's IIG splits a static LOCAL method into a public declaration
+ * <Name> (resolved by the user-space side) and the kernel-side marshaling
+ * entry point <Name>_Call.  Instance LOCAL methods keep <Name>.  This is
+ * why the kernel KPI export lists contain e.g.
+ * IOServiceNotificationDispatchSource::Create_Call but
+ * IODataQueueDispatchSource::Create. */
+bool
+isCallWrapper(const Method &m)
+{
+  return m.isLocal && m.isStatic && !m.isOverride && wantsRpc(m) &&
+         !isPlainVirtualOverride(m);
+}
+
 std::string
+wrapperMethodName(const Method &m)
+{
+  return isCallWrapper(m) ? m.name + "_Call" : m.name;
+}
